{
  "permissions": {
    "deny": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(python3 scripts/accounts/make.py*)",
      "Read(合言葉の表.nosync/**)",
      "Edit(合言葉の表.nosync/**)",
      "Edit(../myenglish/**)",
      "Edit(deploy/accounts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "番人が見ています"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "番人が見ています"
          }
        ]
      }
    ]
  }
}
