{
  "permissions": {
    "deny": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(python3 scripts/accounts/make.py*)",
      "Edit(/deploy/accounts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$g\" ] || g=\"$(git rev-parse --show-toplevel 2>/dev/null </dev/null)/.claude/hooks/guard.py\"; python3 \"$g\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "番人が見ています"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$g\" ] || g=\"$(git rev-parse --show-toplevel 2>/dev/null </dev/null)/.claude/hooks/guard.py\"; python3 \"$g\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "番人が見ています"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ -f \"$g\" ] || g=\"$(git rev-parse --show-toplevel 2>/dev/null </dev/null)/.claude/hooks/guard.py\"; python3 \"$g\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "番人が見ています"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR\"; [ -d \"$d/.githooks\" ] || d=\"$(git rev-parse --show-toplevel 2>/dev/null </dev/null)\"; [ -d \"$d/.githooks\" ] && git -C \"$d\" config core.hooksPath .githooks 2>/dev/null; true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
