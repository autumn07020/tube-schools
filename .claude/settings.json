{
  "permissions": {
    "deny": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(python3 scripts/accounts/make.py*)",
      "Edit(/deploy/accounts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "番人が見ています"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "番人が見ています"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "番人が見ています"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"${CLAUDE_PROJECT_DIR:-.}\" config core.hooksPath .githooks 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
