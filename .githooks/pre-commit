#!/bin/sh
# commit の前に、機械で止められるものを止める：秘密・講師の名字・他言語の字・知識の目次。
# 日本語のファイル名を「\346…」の形にしないよう core.quotePath=false と -z で受け取る（2026-10-14 に漏れていたのを直した）。
ROOT=$(git rev-parse --show-toplevel); cd "$ROOT" || exit 1
# staged の一覧は一時ファイルに（前は $ROOT/.git/staged.z に書いていたが、worktree では .git がファイルなので書けず、
# 「staged が空」と見て全部の検査を黙って飛ばしていた。2026-10-20）
Z=$(mktemp "${TMPDIR:-/tmp}/tube-staged.XXXXXX") || { echo "× 一時ファイルを作れないので commit しません"; exit 1; }
trap 'rm -f "$Z"' EXIT
git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -z > "$Z" || { echo "× staged の一覧を取れないので commit しません"; exit 1; }
[ -s "$Z" ] || exit 0
xargs -0 python3 scripts/check/scan_secrets.py < "$Z" || { echo "× 秘密らしいものがあるので commit しません"; exit 1; }
xargs -0 python3 scripts/check/surnames.py --staged < "$Z" || { echo "× 講師の名字が入っているので commit しません（名字の表がある手元だけで流れる）"; exit 1; }
python3 scripts/check/stdlib_shadow.py >/dev/null || { python3 scripts/check/stdlib_shadow.py; echo "× 標準ライブラリと同じ名前の .py があるので commit しません"; exit 1; }
python3 app/tools/check-source.py >/dev/null 2>&1 || { python3 app/tools/check-source.py | tail -5; echo "× ソースに他言語の字があるので commit しません"; exit 1; }
if [ -f scripts/brain/lint.py ] && tr '\0' '\n' < "$Z" | grep -q '^knowledge/'; then
  python3 scripts/brain/lint.py || { echo "× knowledge/ の決まりに合わないので commit しません"; exit 1; }
fi
exit 0
